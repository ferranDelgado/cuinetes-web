  "instructions": [
    {
      "stepNumber": 1,
      "description": "Wash the spinach well and drain it, keeping the tenderest leaves."
    },
    {
      "stepNumber": 2,
      "description": "Soften the raisins briefly in warm water or sherry."
    },
    {
      "stepNumber": 3,
      "description": "In a large pan, toast the pine nuts in the oil and set them aside."
    },
    {
      "stepNumber": 4,
      "description": "Sauté the sliced garlic cloves and add the spinach in batches, stirring until it wilts completely."
    },
    {
      "stepNumber": 5,
      "description": "Add the raisins and pine nuts, season with salt and pepper and serve hot."
    }
  ],
