  "instructions": [
    {
      "stepNumber": 1,
      "description": "Whisk the eggs with the sugar until pale and fluffy."
    },
    {
      "stepNumber": 2,
      "description": "Add the flour, melted butter, lemon zest and orange blossom water; mix until you get a smooth batter."
    },
    {
      "stepNumber": 3,
      "description": "Heat the neula iron and spoon in a small amount of batter each time, spreading it thin."
    },
    {
      "stepNumber": 4,
      "description": "Cook until light golden, taking care not to burn them."
    },
    {
      "stepNumber": 5,
      "description": "Roll each neula up immediately while hot using a thin stick and let them cool on a wire rack."
    }
  ],
