  "instructions": [
    {
      "stepNumber": 1,
      "description": "Peel the pears keeping the stem intact."
    },
    {
      "stepNumber": 2,
      "description": "Boil the wine with the sugar, cinnamon, cloves and orange peel until the sugar dissolves."
    },
    {
      "stepNumber": 3,
      "description": "Add the pears and cook over a gentle heat for about 30 minutes until tender."
    },
    {
      "stepNumber": 4,
      "description": "Remove the pears and reduce the wine over high heat until it thickens into a syrup."
    },
    {
      "stepNumber": 5,
      "description": "Serve the pears with the syrup, well chilled or at room temperature."
    }
  ],
